# ── Yori Proxy Checker Bot ─────────────────────────────
# Bot token from @BotFather (REQUIRED for Telegram polling)
BOT_TOKEN=

# Optional: HTTP health-check port (default 8080). Platforms inject PORT.
# PORT=8080
# HEALTH_PORT=8080

# Optional: base URL of a local Bot API server (self-hosted telegram-bot-api)
# Leave empty to use https://api.telegram.org
API_BASE_URL=

# Optional overrides — sane defaults built in
# MAX_TARGET_URLS=5
# MAX_FILE_MB=20
# MAX_LINES=300000
# JOB_CONCURRENCY=200
# GLOBAL_CONCURRENCY=600
# MAX_RUNNING_JOBS=4
# DAILY_JOBS_PER_USER=20
# DEFAULT_TARGET_URL=https://api.ipify.org
