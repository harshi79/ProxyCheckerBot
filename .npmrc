# better-sqlite3 13 ships prebuilds/*.node inside the npm tarball and sets
# "gypfile": false, but a lockfile-driven `npm ci` still synthesises
# `node-gyp rebuild` when it sees binding.gyp (npm/cli#9837). That compile
# needs Python and a C++ toolchain, which slim/Nix deploy images do not have.
# Skipping install scripts uses the bundled N-API prebuild instead.
# The only other install scripts in this tree are esbuild (dev) and optional
# fsevents; esbuild resolves its binary through optionalDependencies.
ignore-scripts=true
